# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose to the browser

# ---- Gmail SMTP (optional: announcement emails; use a Google App Password, NOT your normal password) ----
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM_NAME=RK Stores

# ---- Web Push (optional; setup.bat generates these for you, or run: npx web-push generate-vapid-keys) ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:yourname@gmail.com

# ---- Scheduler (protects /api/cron/closing; setup.bat generates a random value) ----
CRON_SECRET=change-me-to-a-long-random-string

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Phone login (optional) ----
# Phone + password accounts are stored under a private, never-emailed address on this domain.
# Leave as is unless Supabase rejects it; any domain you control (or a made-up one) works.
# NEXT_PUBLIC_PHONE_EMAIL_DOMAIN=phone.rkstores.invalid
